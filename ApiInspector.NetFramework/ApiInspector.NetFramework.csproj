<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <RootNamespace>ApiInspector</RootNamespace>
        <AssemblyName>ApiInspector</AssemblyName>
        <LangVersion>preview</LangVersion>
        <ApplicationIcon>$(SolutionDir)Shared\app.ico</ApplicationIcon>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <Reference Include="System.Net.Http" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\AssemblyModel.cs" Link="Shared\AssemblyModel.cs" />
        <Compile Include="..\Shared\AssemblyModelHelper.cs" Link="Shared\AssemblyModelHelper.cs" />
        <Compile Include="..\Shared\AsyncLogger.cs" Link="Shared\AsyncLogger.cs" />
        <Compile Include="..\Shared\FpExtensions.cs" Link="Shared\FpExtensions.cs" />
        <Compile Include="..\Shared\Invocation.Shared.cs" Link="Shared\Invocation.Shared.cs" />
        <Compile Include="..\Shared\MetadataNode.cs" Link="Shared\MetadataNode.cs" />
        <Compile Include="..\Shared\ProcessHelper.cs" Link="Shared\ProcessHelper.cs" />
        <Compile Include="..\Shared\Program.Shared.cs" Link="Shared\Program.Shared.cs" />
        <Compile Include="..\Shared\ReflectionHelper.cs" Link="Shared\ReflectionHelper.cs" />
        <Compile Include="..\shared\toolbox\Result.cs" Link="Shared\Toolbox\Result.cs" />
    </ItemGroup>

    <Target Name="CopyToSolutionBinFolder" AfterTargets="Build">

        <ItemGroup>
            <FilesToCopy Include="$(OutDir)*.*" Exclude="$(OutDir)*.pdb" />
        </ItemGroup>

        <MakeDir Directories="$(SolutionDir)bin\ApiInspector.NetFramework" />

        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(SolutionDir)bin\ApiInspector.NetFramework" />

    </Target>

</Project>
