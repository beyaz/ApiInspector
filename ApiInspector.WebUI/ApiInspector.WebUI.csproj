<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ApplicationIcon>app.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <StartupObject>ApiInspector.WebUI.Program</StartupObject>
    </PropertyGroup>

    <ItemGroup>
      <Content Remove="ApiInspector.WebUI.Config.json" />
    </ItemGroup>

    <ItemGroup>
      <None Include="ApiInspector.WebUI.Config.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\*.*" />
    </ItemGroup>

    <ItemGroup>
      <Compile Include="..\Shared\AssemblyModel.cs" Link="Shared\AssemblyModel.cs" />
      <Compile Include="..\Shared\Toolbox\Result.cs" Link="Shared\Toolbox\Result.cs" />
      <Compile Include="..\Shared\Toolbox\Result.IAsyncEnumerable.cs" Link="Shared\Toolbox\Result.IAsyncEnumerable.cs" />
    </ItemGroup>
	
    <ItemGroup>
      <Folder Include="Properties\" />
    </ItemGroup>


    <ItemGroup>
      <PackageReference Include="Mono.Cecil" Version="0.11.6" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <Reference Include="ReactWithDotNet">
          <HintPath>lib\ReactWithDotNet\ReactWithDotNet.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <None Update="Version.txt">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
        <Content Include="app.ico" />

        <Content Update="web.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>


    <Target Name="StartWithSolutionBinFolder" BeforeTargets="Build">

        <ItemGroup>
            <FilesToCopy Include="$(SolutionDir)bin\**\*.*" />
        </ItemGroup>

        <Copy
            SourceFiles="@(FilesToCopy)"
            DestinationFiles="@(FilesToCopy->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />

    </Target>
    
    <Target Name="CopyToSolutionBinFolder" AfterTargets="Build">

        <ItemGroup>
            <FilesToCopy Include="$(OutDir)*.*" Exclude="$(OutDir)*.pdb" />
        </ItemGroup>

        <MakeDir Directories="$(SolutionDir)bin" />

        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(SolutionDir)bin" />

    </Target>
    
</Project>
