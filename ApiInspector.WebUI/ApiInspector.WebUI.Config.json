{
  "BrowserExePath": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
  "BrowserExeArguments": "--app=http://localhost:{Port}/",
  "HideConsoleWindow": true,
  "NextAvailablePortFrom": 5008,
  "UseUrls": true,

  "CacheDirectoryFormat": "{MyDocuments} > ApiInspector > Cache",

  "InvocationHandlerExePaths": [
    "ApiInspector.BOA.Server.NetFramework.net48/ApiInspector.exe",
    "ApiInspector.BOA.Server.NetCore.net8.0/ApiInspector.exe",
    "ApiInspector.BOA.EOD.net48/ApiInspector.exe",
    "ApiInspector.BOA.Card.NetCore.net8.0/ApiInspector.exe",

    "ApiInspector.NetFramework.net48/ApiInspector.exe",
    "ApiInspector.NetCore.net7.0/ApiInspector.exe",
    "ApiInspector.NetCore.net8.0/ApiInspector.exe",
    "ApiInspector.NetCore.net9.0/ApiInspector.exe",
    "ApiInspector.NetCore.net10.0/ApiInspector.exe"
  ],

  "DirectorySuggestions": [
    "d:/boa/server/bin/",
    "d:/boa/BOA.WebApi.Core/",
    "d:/boa/client/bin/",
    "d:/boa/card/*"
  ],

  "InvokerAppFinderMethod": "ApiInspector.BOASystem > ApiInspector.BOASystem.InvokerAppFinder > FindInvokerAppFolderName"
}