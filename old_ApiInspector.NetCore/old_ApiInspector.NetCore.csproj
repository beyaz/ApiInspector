<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>ApiInspector</AssemblyName>
        <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
        <ApplicationIcon>app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\old_ApiInspector.NetFramework\GlobalUsings.cs" Link="GlobalUsings.cs" />
        <Compile Include="..\old_ApiInspector.NetFramework\JsonInternalAssigner.cs" Link="JsonInternalAssigner.cs" />
        <Compile Include="..\old_ApiInspector.NetFramework\Plugin.cs" Link="Plugin.cs" />
        <Compile Include="..\old_ApiInspector.NetFramework\Program.cs" Link="Program.cs" />
        <Compile Include="..\old_ApiInspector.NetFramework\JsonConverterForPropertyInfo.cs" Link="JsonConverterForPropertyInfo.cs" />
        <Compile Include="..\Shared\AssemblyModel.cs" Link="Shared\AssemblyModel.cs" />
        <Compile Include="..\Shared\AssemblyModelHelper.cs" Link="Shared\AssemblyModelHelper.cs" />
        <Compile Include="..\Shared\AsyncLogger.cs" Link="Shared\AsyncLogger.cs" />
        <Compile Include="..\Shared\FpExtensions.cs" Link="Shared\FpExtensions.cs" />
        <Compile Include="..\Shared\Invocation.Shared.cs" Link="Shared\Invocation.Shared.cs" />
        <Compile Include="..\Shared\MetadataNode.cs" Link="Shared\MetadataNode.cs" />
        <Compile Include="..\Shared\ProcessHelper.cs" Link="Shared\ProcessHelper.cs" />
        <Compile Include="..\Shared\ReflectionHelper.cs" Link="Shared\ReflectionHelper.cs" />
        <Compile Include="..\shared\toolbox\Result.cs" Link="Shared\Toolbox\Result.cs" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="app.ico" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.2.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>


    <ItemGroup>
        <PackageReference Include="BOA.Compatibility" Version="1.*" />
    </ItemGroup>


    <ItemGroup>
      <Folder Include="Shared\Toolbox\" />
    </ItemGroup>
    <PropertyGroup>
        <PostBuildEvent>
            copy /y "$(OutDir)$(AssemblyName).*" D:\BOA\tools\ApiInspector\ApiInspector.NetCore\
        </PostBuildEvent>
    </PropertyGroup>

</Project>
