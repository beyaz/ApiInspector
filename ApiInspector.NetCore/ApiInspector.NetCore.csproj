<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>ApiInspector</RootNamespace>
        <AssemblyName>ApiInspector</AssemblyName>
        <LangVersion>preview</LangVersion>
        <ApplicationIcon>../Shared/app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Shared\AssemblyModel.cs" Link="Shared\AssemblyModel.cs" />
        <Compile Include="..\Shared\AssemblyModelHelper.cs" Link="Shared\AssemblyModelHelper.cs" />
        <Compile Include="..\Shared\AsyncLogger.cs" Link="Shared\AsyncLogger.cs" />
        <Compile Include="..\Shared\Invocation.Shared.cs" Link="Shared\Invocation.Shared.cs" />
        <Compile Include="..\Shared\Program.Shared.cs" Link="Shared\Program.Shared.cs" />
        <Compile Include="..\Shared\ReflectionHelper.cs" Link="Shared\ReflectionHelper.cs" />
        <Compile Include="..\shared\toolbox\Result.cs" Link="Shared\Toolbox\Result.cs" />
    </ItemGroup>

    <Target Name="CopyToSolutionBinFolder" AfterTargets="Build">

        <ItemGroup>
            <FilesToCopy Include="$(OutDir)*.*" Exclude="$(OutDir)*.pdb" />
        </ItemGroup>

        <MakeDir Directories="$(SolutionDir)bin\ApiInspector.NetCore.$(TargetFramework)" />

        <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(SolutionDir)bin\ApiInspector.NetCore.$(TargetFramework)" />

        <RemoveDir Directories="$(SolutionDir)bin\ApiInspector.NetCore" />

    </Target>

</Project>
